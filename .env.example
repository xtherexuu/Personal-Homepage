# Template for .env.local — copy, fill in, never commit the filled copy.

# ── SMTP (outgoing replies from the admin panel) ─────────────────────────────
# Proton Mail SMTP submission: smtp.protonmail.ch:587 (STARTTLS), the password
# is an SMTP token generated in Proton settings, not the account password.
# Contact-form enquiries no longer travel over SMTP — they land in the panel's
# SQLite inbox (data/admin.db); only replies sent FROM the panel use this.
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USER=you@your-domain.com
SMTP_PASS=your-smtp-token

# ── Admin panel (/admin) ─────────────────────────────────────────────────────
# Session-signing secret, min. 32 chars. Generate:  openssl rand -base64 48
# Rotating it instantly invalidates every active admin session.
SESSION_SECRET=

# The ONE admin account. No registration exists; these env values ARE the user.
ADMIN_USER=

# argon2id hash of the admin password, wrapped in base64 (Next's .env loader
# expands $VAR references and would mangle a raw $argon2id$… string).
# Generate with:  npm run admin:hash
ADMIN_PASSWORD_HASH=
