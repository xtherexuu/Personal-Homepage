# Template for .env.local — copy, fill in, never commit the filled copy.
# SMTP credentials for the contact-form route (app/api/contact/route.ts).
# Proton Mail SMTP submission: smtp.protonmail.ch:587 (STARTTLS), the password
# is an SMTP token generated in Proton settings, not the account password.
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USER=you@your-domain.com
SMTP_PASS=your-smtp-token

# Where form enquiries are delivered TO. Optional — defaults to SMTP_USER.
CONTACT_INBOX=you@your-domain.com
